<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>SimpleX relay setup</title>
    <link rel="stylesheet" href="/styles.css">
    <script src="/config.js" defer></script>
    <script src="/app.js" defer></script>
  </head>
  <body>
    <main class="setup" aria-labelledby="page-title">
      <p class="eyebrow">Local relay setup</p>
      <h1 id="page-title">Connect to your SimpleX SMP relay</h1>
      <p class="intro">Use this address when adding a private SMP server in SimpleX Chat.</p>

      <section class="relay" aria-labelledby="relay-address-title">
        <div class="section-heading">
          <h2 id="relay-address-title">Server address</h2>
          <span class="status" id="status" role="status" aria-live="polite" data-state="loading">Loading fingerprint</span>
        </div>

        <div class="address-row">
          <output class="address address--hidden" id="relay-address" aria-label="SimpleX SMP server address" aria-live="off">Preparing address…</output>
          <div class="actions" aria-label="Address actions">
            <button class="button button--secondary" id="reveal" type="button" disabled aria-pressed="false">Reveal</button>
            <button class="button" id="copy" type="button" disabled>Copy address</button>
          </div>
        </div>
        <p class="feedback" id="feedback" role="status" aria-live="polite"></p>
      </section>

      <section class="details" aria-labelledby="details-title">
        <h2 id="details-title">Before you connect</h2>
        <ul>
          <li>The relay endpoint must be publicly reachable over TCP port <code>5223</code>.</li>
          <li>Keep this address private. It contains the relay access password.</li>
          <li>This setup page is local-only and is not a public relay directory.</li>
        </ul>
      </section>
    </main>
  </body>
</html>
