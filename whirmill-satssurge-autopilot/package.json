{
  "name": "@whirmill/satssurge-autopilot",
  "version": "0.5.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run patch:pi && tsc && tsc -p tsconfig.frontend.json && vite build",
    "start": "node dist/server.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "import": "node dist/import-cli.js",
    "dev": "vite",
    "typecheck": "npm run patch:pi && tsc --noEmit && tsc -p tsconfig.frontend.json",
    "patch:pi": "node scripts/pi-scoped-stop-patch.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.26",
    "@base-ui/react": "1.9.0",
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@radix-ui/react-slot": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.54.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "postcss-prefix-selector": "2.2.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vite": "8.3.4"
  }
}
